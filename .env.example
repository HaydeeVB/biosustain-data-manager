# BioSustain SaaS — Environment Variables
# Copy to .env and fill in real values

# Server
PORT=8080
NODE_ENV=development

# JWT Auth
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_EXPIRES_IN=24h

# Database (TimescaleDB / PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/biosustain
# Or individual fields:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=biosustain
DB_USER=biosustain
DB_PASSWORD=change-me

# CORS — restrict to known origins in production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Cerebro (private model server)
CEREBRO_URL=http://localhost:8001
CEREBRO_API_KEY=change-me

# Payments
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Existing IoT API (the deployed digital twin)
IOT_API_URL=https://bio-morphix-digital-twin-59938418579.us-west1.run.app